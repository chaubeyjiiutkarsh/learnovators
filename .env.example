# ---------------------------------------------------------------------------
# Frontend environment (read by Vite — variables must start with VITE_)
# ---------------------------------------------------------------------------

# Optional: enable REAL Google sign-in.
# Create an OAuth Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials with
# Authorized JavaScript origin: http://localhost:5173
# Paste the same value into GOOGLE_CLIENT_ID in backend/.env as well.
# If empty, the Google button uses a built-in demo account instead.
VITE_GOOGLE_CLIENT_ID=

# Optional: only needed if the API runs on a different origin than the
# frontend (e.g. separate deployment). Local dev uses the Vite proxy instead.
VITE_API_URL=

# Port the API server listens on
PORT=4000

# Secret used to sign JWT session tokens.
# Use a long random string. Never share or commit the real value.
JWT_SECRET=change-this-to-a-long-random-secret-string

# How long a login session (token) stays valid
JWT_EXPIRES_IN=7d

# Optional: real Google sign-in.
# Create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# (Application type: Web application, Authorized origin: http://localhost:5173)
# and paste the same value into VITE_GOOGLE_CLIENT_ID in the root .env file.
# If left empty, the app falls back to a built-in demo Google account.
GOOGLE_CLIENT_ID=

# SQLite database file location (relative to the backend folder)
DB_FILE=data/learnovators.db

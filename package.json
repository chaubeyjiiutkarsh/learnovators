{
  "name": "learnovators",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend",
    "dev": "concurrently -n \"API\",\"WEB\" -c \"blue\",\"green\" \"npm run dev:back\" \"npm run dev:front\"",
    "dev:front": "vite",
    "dev:back": "npm run dev --prefix backend",
    "build": "vite build",
    "start": "node backend/server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.4"
  }
}
